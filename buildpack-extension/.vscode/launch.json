{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bashdb",
      "request": "launch",
      "name": "Bash-Debug (simplest configuration)",
      "program": "${file}"
    },
    {
      "type": "bashdb",
      "request": "launch",
      "name": "package.sh",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/scripts/package.sh",
      "args": ["--version", "0.0.2"]
    },
    {
      "name": "integration",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}/../integration",
      "env": {
        "GOOS": "linux",
        "CGO_ENABLED": "0",
        "PATH": "${env:PATH}:${fileDirname}/../.bin"
      },
      "args": [
        "count",
        "1",
        "timeout",
        "0",
        "./integration/...",
        "-v",
        "-run",
        "Integration"
      ]
    },
    {
      "name": "make retrieve",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/dependency/retrieval",
      "cwd": "${workspaceFolder}/dependency/retrieval",
      "env": {
        "GOOS": "linux",
        "CGO_ENABLED": "0",
        "PATH": "${env:PATH}:${workspaceFolder}/.bin"
      },
      "args": [
        "--buildpack_toml_path",
        "${workspaceFolder}/buildpack.toml",
        "--output",
        "${workspaceFolder}/metadata.json"
      ]
    },
  ]
}
