  "version": "0.2.0",
  "configurations": [
    {
      "name": "bash simple",
      "type": "bashdb",
      "request": "launch",
      "program": "${file}"
    },
    {
      "name": "smoke bash",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke.sh",
      "args": [
        "--builder-dir",
        "${workspaceFolder}/builders/builder_buildpackless"
      ]
    },
    {
      "name": "smoke bash no args",
      "type": "bashdb",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke.sh"
    }
  ]
}
