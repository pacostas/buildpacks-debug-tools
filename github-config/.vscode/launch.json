{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "get usns",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/actions/stack/get-usns/entrypoint",
      "env": {
        "GOOS": "linux",
        "CGO_ENABLED": "0",
        "PATH": "${env:PATH}"
      },
      "args": [
        "--last-usns-filepath",
        "${workspaceFolder}/previous_patched-usns_noble.json",
        "--packages-filepath",
        "${workspaceFolder}/packages_noble_0.0.30.json",
        "--distro",
        "noble",
        "--output",
        "${workspaceFolder}/patched-usns_noble.json"
      ]
    },
    {
      "name": "unit",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/actions/stack/get-usns/entrypoint",
      "env": {
        "GOOS": "linux",
        "CGO_ENABLED": "0",
        "PATH": "${env:PATH}:${workspaceFolder}/.bin"
      },
      "args": []
    }
  ]
}
